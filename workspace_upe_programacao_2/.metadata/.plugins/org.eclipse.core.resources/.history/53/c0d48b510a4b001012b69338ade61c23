package upe_programacao_2;

import java.io.FileReader;
import java.io.IOException;
import java.util.Arrays;
import java.util.List;

import com.google.gson.*;

public class JsonReader {
	private static Gson gson = new GsonBuilder()
			.registerTypeAdapter(Cliente.class, new ClienteTypeAdapter())
			.create();
	
	// Métodos para carregar objetos em memória
	public static void carregarClientes() {
        try (FileReader fr = new FileReader("clientes.json")) {
            // Verifica se o arquivo está vazio
            if (fr.read() == -1) {
                return;
            }
            
            // Tenta ler como array primeiro
            try {
                Cliente[] clientesArray = gson.fromJson(new FileReader("clientes.json"), Cliente[].class);
                if (clientesArray != null) {
                    Cliente.getListaClientes().clear();
                    Cliente.getListaClientes().addAll(Arrays.asList(clientesArray));
                    // Atualiza o contador
                    Cliente.count.set(Cliente.getListaClientes().stream()
                            .mapToInt(Cliente::getIdCliente)
                            .max().orElse(0));
                }
            } catch (JsonSyntaxException e) {
                // Se falhar, tenta ler como objeto único
                FileReader fr2 = new FileReader("clientes.json");
                Cliente cliente = gson.fromJson(fr2, Cliente.class);
                if (cliente != null) {
                    Cliente.getListaClientes().clear();
                    Cliente.getListaClientes().add(cliente);
                    Cliente.count.set(cliente.getIdCliente());
                }
            }
        } catch (IOException e) {
            System.err.println("Erro ao carregar clientes: " + e.getMessage());
        }
    }
	
